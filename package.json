{
  "name": "agent-mcp-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --filter @demo/agent dev",
    "dev:agent": "pnpm --filter @demo/agent dev",
    "dev:weather": "pnpm --filter @demo/weather dev",
    "dev:weather:http": "pnpm --filter @demo/weather dev:http",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r exec rm -rf dist"
  }
}
